# Environment variables required by the Supabase Edge Functions in this
# directory.
#
# Local development: copy this file to `.env` (already gitignored) in this
# same directory and fill in real values. `supabase functions serve` and
# `supabase start` read it automatically.
#
# Production: set these as project secrets instead of committing a `.env`
# file, e.g. `supabase secrets set GLOO_CLIENT_ID=... GLOO_CLIENT_SECRET=...`.
#
# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# NOT listed here — they're auto-injected by the Supabase edge runtime
# (locally and in production) and must never be set manually.

# Gloo AI client credentials, used in _shared/glooClient.ts by
# assess-desperation, recommend-severity, and all generate-* functions.
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=

# YouVersion passage lookup API, used by youversion-passage/index.ts.
# YOUVERSION_API_URL may include a `{reference}` placeholder, or be a base
# URL that a `?reference=` query param gets appended to. YOUVERSION_API_KEY
# is sent as a bearer token if present.
YOUVERSION_API_URL=
YOUVERSION_API_KEY=
